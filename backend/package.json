{
  "name": "ubbike-backend",
  "version": "0.1.0",
  "description": "Backend API REST para UBBike.",
  "main": "dist/servidor.js",
  "scripts": {
    "dev": "prisma generate && tsx watch src/servidor.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/servidor.js",
    "generate": "prisma generate",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "typecheck": "prisma generate && tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" --ignore-pattern \"src/generated/**\"",
    "format": "prettier --write \"src/**/*.ts\" \"!src/generated/**\""
  },
  "keywords": [
    "ubbike",
    "bicicletero",
    "express",
    "postgresql"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^8.0.7",
    "pg": "^8.13.1",
    "prisma": "^7.8.0",
    "redis": "^5.10.0"
  },
  "overrides": {
    "uuid": "14.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/helmet": "^0.0.48",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
