NODE_ENV=production
PORT=3001

DB_HOST=localhost
DB_PORT=5433
DB_USER=ubbike
DB_PASSWORD=REEMPLAZAR_POR_PASSWORD_SEGURO_DE_16_O_MAS_CARACTERES
DB_NAME=ubbike
DATABASE_URL=postgresql://ubbike:REEMPLAZAR_POR_PASSWORD_SEGURO_DE_16_O_MAS_CARACTERES@localhost:5433/ubbike?schema=public
SEED_DEMO_DATA=false

JWT_SECRET=REEMPLAZAR_POR_SECRETO_LARGO_DE_32_O_MAS_CARACTERES
JWT_EXPIRES_IN=2h
JWT_ISSUER=ubbike-api
JWT_AUDIENCE=ubbike-app
CORS_ORIGINS=http://localhost:8082,http://127.0.0.1:8082
TRUST_PROXY=false
REDIS_URL=redis://localhost:6380
REQUIRE_REDIS_RATE_LIMIT=true

# Produccion recomendada con Brevo SMTP
# SMTP user y password se obtienen en Brevo > Transactional > SMTP.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REEMPLAZAR_POR_LOGIN_SMTP_DE_BREVO
SMTP_PASSWORD=REEMPLAZAR_POR_SMTP_KEY_DE_BREVO
MAIL_FROM=UBBike <no-reply@tu-dominio.cl>
FRONTEND_URL=http://localhost:8082
