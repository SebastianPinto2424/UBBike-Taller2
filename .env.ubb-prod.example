POSTGRES_DB=ubbike
POSTGRES_USER=ubbike_app
POSTGRES_PASSWORD=<GENERAR_openssl_rand_base64_24>

PUBLIC_API_BASE_URL=https://<HOST_O_IP>:<PUERTO_HTTPS>
PUBLIC_WS_BASE_URL=wss://<HOST_O_IP>:<PUERTO_HTTPS>

JWT_SECRET=<GENERAR_openssl_rand_base64_48>
JWT_EXPIRES_IN=2h
JWT_ISSUER=ubbike-api
JWT_AUDIENCE=ubbike-app
REFRESH_TOKEN_EXPIRES_DAYS=30
QR_DURATION_SECONDS=15

SEED_DEMO_DATA=false
SWAGGER_ENABLED=false

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<CORREO_NOTIFICACIONES>
SMTP_PASSWORD=<APP_PASSWORD_GMAIL>
MAIL_FROM=UBBike <no-reply@ubbike.cl>
