[Unit]
Description=UBBike Backend
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/ubbike/backend
EnvironmentFile=/opt/ubbike/backend/.env
ExecStart=/usr/bin/node /opt/ubbike/backend/dist/servidor.js
Restart=always
RestartSec=5
User=www-data
Group=www-data
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
